{# Built only when pricing is true in src/_data/site.js. #}
<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <div class="section-head">
    <h2 id="pricing-title">A free library. AI Access with Pro.</h2>
    <p>Save, search and sync your highlights for free. Twine Pro adds read-only AI Access on your Mac and on-device AI context.</p>
  </div>
  <div class="plans">
    <article class="plan" aria-labelledby="plan-free">
      <h3 id="plan-free">Free</h3>
      <p class="price"><span class="amount">$0</span></p>
      <ul class="checks" role="list">
        <li>Highlight in Safari on Mac and iPhone, with auto-highlight on Mac</li>
        <li>A searchable library on Mac and iPhone</li>
        <li>iCloud sync between your devices</li>
        <li>Copy and share as text or Markdown</li>
        <li>Spotlight and Shortcuts</li>
      </ul>
    </article>
    <article class="plan plan-featured" aria-labelledby="plan-pro">
      <h3 id="plan-pro">Pro</h3>
      <p class="price"><span class="amount">$4.99</span> once</p>
      <p class="plan-note">{% if site.appStoreUrl %}A one-time in-app purchase.{% else %}A one-time purchase when Twine launches.{% endif %} No subscription.</p>
      <ul class="checks" role="list">
        <li>Everything in Free</li>
        <li>AI Access: let compatible AI tools search and read your highlights</li>
        <li>On-device AI context</li>
      </ul>
    </article>
  </div>
  <p class="pricing-foot">{% if site.appStoreUrl %}Pro is bought in the app through the App Store.{% else %}Twine is coming soon. Pro will be bought in the app through the App Store.{% endif %} Prices are in US dollars, and the App Store shows your local price. AI tools, and any fees from their providers, are separate.</p>
</section>
